  var seconds = formatDateTime("%S");
  var delay = (528 + 60 - (seconds[0] * 10 + seconds[1])) * 1000;
  startTimer(TIMER_ID_TIMER, delay, 0, @redrawDisplayOverlay);

  drawText(0, DISPLAY_WIDTH/2, 12, 0, 1, formatDateTime("%H:%M"));
