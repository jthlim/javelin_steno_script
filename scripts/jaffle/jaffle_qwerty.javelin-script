var _lastX0;
var _lastY0;
var _lastZ0;
func onPointerInput0(x, y, z) {
  {
    if (z && _lastZ0) {
      var _lastAngle = (atan2(_lastY0, _lastX0) & 0xffff) / 8192 * 536870912;
      var _angle = (atan2(y, x) & 0xffff) / 8192 * 536870912;

      var delta = (((_angle - _lastAngle) >> 16) * 8 + 0x8000) >> 16;
      if (delta) {
        vWheelMouse(-1 * delta);
      }
    }
  }
  _lastX0 = x;
  _lastY0 = y;
  _lastZ0 = z;
}

var _lastX1;
var _lastY1;
var _lastZ1;
func onPointerInput1(x, y, z) {
  if (z && !_lastZ1) {
    // \n\nActivate Mouse Layer

    onMouseActive();
  }
  if (!z && _lastZ1) {
    //
    onMouseInactive();
  }
  if (z && _lastZ1) {
    var _lastRotX = (31651 * _lastX1 + -8481 * _lastY1) >> 16;
    var _lastRotY = (8481 * _lastX1 + 31651 * _lastY1) >> 16;

    var _rotX = (31651 * x + -8481 * y) >> 16;
    var _rotY = (8481 * x + 31651 * y) >> 16;

    moveMouse(_rotX - _lastRotX, _rotY - _lastRotY);
  }
  _lastX1 = x;
  _lastY1 = y;
  _lastZ1 = z;
}
